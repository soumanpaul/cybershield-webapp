NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Use a direct or Session pooler URL (port 5432) for LISTEN/NOTIFY.
DATABASE_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:5432/postgres?sslmode=require
# Optional. If set, mobile clients must send: Authorization: Bearer <value>
MOBILE_API_KEY=
# Adds five sample users only when captured_users is completely empty.
SEED_DEMO_DATA=true
